# Copy this file to /opt/audit_robot/.env and fill real values on the server.
# Do not commit or share the real .env file.

VISION_API_BASE_URL=
VISION_API_KEY=
VISION_MODEL_NAME=qwen3.7-plus

GUOBU_COLLECTOR_BASE_URL=https://approval.jhddsz.com
GUOBU_APPROVAL_BASE_URL=https://approval.jhddsz.com
GUOBU_AUTH_TOKEN=
MACHINE_APPROVAL_AUTH_TOKEN=

GUOBU_AUDIT_STATE_DIR=/var/lib/audit_robot/state
GUOBU_AUDIT_TEMP_DIR=/tmp/audit_robot_guobu
GUOBU_AUDIT_LEASE_SECONDS=3600
GUOBU_POLL_INTERVAL_SECONDS=600
GUOBU_PENDING_HEARTBEAT_THRESHOLD=5
GUOBU_PAGE_SIZE=20
GUOBU_MAX_FETCH_PAGES=0
GUOBU_EXIT_NONZERO_ON_ERRORS=true

# Production SN/compliance/photo-auth policy.
SN_HOME_APPLIANCE_EXACT_MATCH_CONFLICT_RESCUE=true
